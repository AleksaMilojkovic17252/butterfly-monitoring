# Copy to .env and fill in. Never commit .env.
# Draft: T002 owns this file and must list every variable the stack reads.
# Names marked "from ticket" appear in the tickets; the rest are TODO(T002) placeholders to confirm.

# --- Django (T003, T009) ---
DJANGO_SECRET_KEY=change-me                     # TODO(T002): confirm name
DJANGO_DEBUG=false                              # TODO(T002): confirm name; true only with compose.dev.yaml
ALLOWED_HOSTS=localhost,127.0.0.1,<laptop>.<tailnet>.ts.net          # from ticket T009
CSRF_TRUSTED_ORIGINS=https://<laptop>.<tailnet>.ts.net               # from ticket T009

# --- PostgreSQL / PostGIS (T002, T004) ---
POSTGRES_DB=butterfly                           # database name from the conventions (A.5)
POSTGRES_USER=postgres                          # TODO(T002): superuser for db-init only?
POSTGRES_PASSWORD=change-me
DJANGO_DB_USER=django_app                       # role name from T002; TODO(T002): variable name
DJANGO_DB_PASSWORD=change-me
PYGEOAPI_DB_USER=pygeoapi_ro                    # role name from T002
PYGEOAPI_DB_PASSWORD=change-me                  # from ticket
DB_HOST=db                                      # TODO(T002)
DB_PORT=5432

# --- MinIO / S3 via django-storages (T002, T003) ---
MINIO_ROOT_USER=change-me                       # TODO(T002)
MINIO_ROOT_PASSWORD=change-me                   # TODO(T002)
AWS_S3_ENDPOINT_URL=http://minio:9000           # from ticket T003
AWS_STORAGE_BUCKET_NAME=photos                  # bucket name from ticket T003
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# --- Backups (T010) ---
BACKUP_ENCRYPTION_KEY=                          # optional age/gpg recipient; TODO(T010): name and format
