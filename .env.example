# Copy to .env (`cp .env.example .env`) and replace every change-me. Never commit .env.
# Compose reads this file from the repository root (--project-directory .).

# --- Django (T003, T009) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false                              # compose.dev.yaml sets true
ALLOWED_HOSTS=localhost,127.0.0.1,<laptop>.<tailnet>.ts.net          # from ticket T009
CSRF_TRUSTED_ORIGINS=https://<laptop>.<tailnet>.ts.net               # from ticket T009

# --- PostgreSQL / PostGIS (T002, T004) ---
POSTGRES_DB=butterfly                           # database name from the conventions (A.5)
POSTGRES_USER=postgres                          # superuser, used only by the db container and db-init
POSTGRES_PASSWORD=change-me
DJANGO_DB_USER=django_app                       # owner role created by db-init/01-init.sh
DJANGO_DB_PASSWORD=change-me
PYGEOAPI_DB_USER=pygeoapi_ro                    # read-only role created by db-init/01-init.sh
PYGEOAPI_DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- MinIO / S3 via django-storages (T002, T003) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
AWS_S3_ENDPOINT_URL=http://minio:9000           # from ticket T003
AWS_STORAGE_BUCKET_NAME=photos                  # bucket name from ticket T003
# The MinIO user Django uses (T049), limited to the bucket. Run scripts/minio-setup.sh after setting
# these (and again after a fresh volume). The secret needs at least 8 characters: `openssl rand -hex 24`.
AWS_ACCESS_KEY_ID=butterfly-django
AWS_SECRET_ACCESS_KEY=change-me

# --- Backups (T010) ---
# gpg recipient (key ID or email) from your keyring. Empty = backups are not encrypted.
BACKUP_ENCRYPTION_KEY=
